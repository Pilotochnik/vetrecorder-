# VetRecorder — переменные окружения
# Скопируйте в .env и заполните значения

# === ОБЯЗАТЕЛЬНЫЕ ===

# OpenAI (Whisper + GPT)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_WHISPER_MODEL=whisper-1

# Telegram-бот (для /auth и голосовых в боте)
API_TOKEN=your_bot_token_from_BotFather
BOT_USERNAME=vetera_ai_bot

# База данных
# PostgreSQL (Render, Railway, Neon и т.д.):
DATABASE_URL=postgresql://user:password@host:5432/dbname
# SQLite (локально):
# DATABASE_URL=sqlite+aiosqlite:///vetrecorder.db

# === ДЛЯ ДЕПЛОЯ (Render, Railway, Heroku) ===
# PORT задаётся платформой автоматически — не трогать

# Flask
FLASK_DEBUG=False
SECRET_KEY=сгенерируйте-случайную-строку-для-продакшена
PORT=5000

# Папка для загрузок (создаётся автоматически)
UPLOAD_FOLDER=uploads

# === ОПЦИОНАЛЬНЫЕ ===
# RATE_LIMIT_ENABLED=True
# RATE_LIMIT_PER_MINUTE=10
# GPT_TEMPERATURE=0.2
# GPT_MAX_TOKENS=1500
# GPT_TIMEOUT=60.0
